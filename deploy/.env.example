# Local: cp deploy/.env.example deploy/.env
# VM:    /opt/notinspec/.env (outside the runner workspace, which is wiped on checkout)

POSTGRES_PASSWORD=change-me

# GHCR image owner (lowercase GitHub org) and tag; defaults build local images
IMAGE_OWNER=local
TAG=latest
WEB_PORT=8080
HTTPS_PORT=8443
# hostname for HTTPS (VM: 147-175-151-17.sslip.io); empty = plain HTTP on :80
SITE_ADDRESS=

# Never commit real values
LLM_API_KEY=
LLM_BASE_URL=
SLACK_WEBHOOK_URL=
# token the GitHub Action sends with results (POST /api/runs); empty disables it
INGEST_TOKEN=
