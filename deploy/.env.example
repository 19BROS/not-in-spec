# Local: cp deploy/.env.example deploy/.env
# VM:    /opt/notinspec/.env (outside the runner workspace, which is wiped on checkout)

POSTGRES_PASSWORD=change-me
# password of notinspec_app, the role api and worker connect as (`migrate` sets it on every deploy);
# letters and digits only, like POSTGRES_PASSWORD: both go into a postgresql:// URL unescaped
NOTINSPEC_APP_PASSWORD=change-me-too

# GHCR image owner (lowercase GitHub org) and tag; defaults build local images
IMAGE_OWNER=local
TAG=latest
WEB_PORT=8080
HTTPS_PORT=8443
# hostname for HTTPS (VM: 147-175-151-17.sslip.io); empty = plain HTTP on :80
SITE_ADDRESS=

# Never commit real values
# FIIT LiteLLM proxy (claim extractors; only the free local models are allowed, SPEC §8)
FIIT_API_KEY=
# Groq (models under test)
GROQ_API_KEY=
SLACK_WEBHOOK_URL=
# token the GitHub Action sends with results (POST /api/runs); empty disables it
INGEST_TOKEN=

# Hosted uploads remain disabled until add-project (migrations run on every deploy); see docs/hosted-ci.md.
NOTINSPEC_UPLOADS_ENABLED=0
NOTINSPEC_PUBLIC_URL=https://147-175-151-17.sslip.io
# 1 runs the existing live FIIT extractors + local NLI in the worker; 0 only ingests.
NOTINSPEC_HOSTED_CLAIMS=0
