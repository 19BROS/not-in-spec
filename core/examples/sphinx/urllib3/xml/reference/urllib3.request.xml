l_emphasis><reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/stdtypes.html#tuple"><literal_emphasis>tuple</literal_emphasis></reference><literal_emphasis>[</literal_emphasis><reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/stdtypes.html#str"><literal_emphasis>str</literal_emphasis></reference><literal_emphasis>, </literal_emphasis><reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/stdtypes.html#str"><literal_emphasis>str</literal_emphasis></reference><literal_emphasis> | </literal_emphasis><reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/stdtypes.html#bytes"><literal_emphasis>bytes</literal_emphasis></reference><literal_emphasis>, </literal_emphasis><reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/stdtypes.html#str"><literal_emphasis>str</literal_emphasis></reference><literal_emphasis>]</literal_emphasis><literal_emphasis>] </literal_emphasis><literal_emphasis>| </literal_emphasis><reference internal="1" reftitle="urllib3.fields.RequestField" refuri="urllib3.fields#urllib3.fields.RequestField"><literal_emphasis>RequestField</literal_emphasis></reference><literal_emphasis>] </literal_emphasis><literal_emphasis>| </literal_emphasis><reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/library/typing.html#typing.Mapping"><literal_emphasis>Mapping</literal_emphasis></reference><literal_emphasis>[</literal_emphasis><reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/stdtypes.html#str"><literal_emphasis>str</literal_emphasis></reference><literal_emphasis>, </literal_emphasis><reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/stdtypes.html#str"><literal_emphasis>str</literal_emphasis></reference><literal_emphasis> | </literal