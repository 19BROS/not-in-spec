                                    <classifier>str (default: “zen_launch”)</classifier>
                                    <definition>
                                        <paragraph>Name of the stored configuration in Hydra’s ConfigStore API.</paragraph>
                                    </definition>
                                </definition_list_item>
                                <definition_list_item>
                                    <term><strong>job_name</strong></term>
                                    <classifier>str (default: “zen_launch”)</classifier>
                                    <definition>
                                        <comment xml:space="preserve"></comment>
                                    </definition>
                                </definition_list_item>
                                <definition_list_item>
                                    <term><strong>with_log_configuration</strong></term>
                                    <classifier>bool (default: True)</classifier>
                                    <definition>
                                        <paragraph>If <literal>True</literal>, enables the configuration of the logging subsystem from the loaded
                                            config.</paragraph>
                                    </definition>
                                </definition_list_item>
                                <definition_list_item>
                                    <term><strong>execution_whitelist</strong></term>
                                    <classifier>str | Sequence[str] | UNSAFE_DISABLE_EXECUTION_CHECKS, optional</classifier>
                                    <definition>
                                        <paragraph>Requires hydra-core 1.4 or later. The execution whitelist that is active
                                            while the job runs (see <literal>hydra.main(execution_whitelist=...)</literal>). If not
                                            specified, an active <literal>hydra.utils.execution_whitelist(...)</literal> context is
                                            used, if any.</paragraph>
                                        <paragraph>As with <literal>hydra.main</literal>, a specified whitelist <emphasis>replaces</emphasis> (rather than
                                            extends) an active <literal>execution_whitelist(...)</literal> context for the duration of
                                            the job. This differs from <literal>instantiate(..., _execution_whitelist_=...)</literal>,
                                            which extends an active context. Include any entries that you need, e.g.
                                            <literal>execution_whitelist=["auto", "torch.*"]</literal>.</paragraph>
                                        <paragraph><literal>"auto"</literal>, either alone or as an entry in a sequence, expands to every
                                            target that hydra-zen generated in-code (via <literal>builds</literal>, <literal>just</literal>, etc.)
                                            during this process. See <reference internal="1" reftitle="hydra_zen.instantiate" refuri="hydra_zen.instantiate#hydra_zen.instantiate"><literal classes="xref py py-func">instantiate()</literal></reference> for details.</paragraph>
                                    </definition>
                                </definition_list_item>
