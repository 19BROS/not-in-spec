                                </definition_list_item>
                                <definition_list_item>
                                    <term><strong>parser</strong></term>
                                    <classifier>Type[pydantic.validate_arguments], optional</classifier>
                                    <definition>
                                        <paragraph>A configured instance of pydantic’s validation decorator.</paragraph>
                                        <definition_list>
                                            <definition_list_item>
                                                <term>The default validator that we provide specifies:</term>
                                                <definition>
