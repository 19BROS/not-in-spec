                                            </definition>
                                        </definition_list_item>
                                        <definition_list_item>
                                            <term><strong>primitive_only: bool, optional (default=False)</strong></term>
                                            <definition>
                                                <paragraph>If true, only <reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/functions.html#bool"><literal classes="xref py py-obj">bool</literal></reference> | <reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/constants.html#None"><literal classes="xref py py-obj">None</literal></reference> | <reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/functions.html#int"><literal classes="xref py py-obj">int</literal></reference> | <reference internal="0" reftitle="(in Python v3.15)" refuri="https://docs.python.org/3/builtins/functions.html#float"><literal classes="xref py py-obj">float</literal></reference> | str`
