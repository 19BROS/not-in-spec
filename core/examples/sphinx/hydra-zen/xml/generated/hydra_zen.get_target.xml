                <paragraph>It works for manually-defined configs:</paragraph>
                <doctest_block classes="doctest" xml:space="preserve">&gt;&gt;&gt; from dataclasses import dataclass
&gt;&gt;&gt; @dataclass
... class A:
...     _target_: str = "builtins.dict"</doctest_block>
                <doctest_block classes="doctest" xml:space="preserve">&gt;&gt;&gt; get_target(A())
&lt;class 'dict'&gt;</doctest_block>
                <paragraph>and for configs loaded from yamls.</paragraph>
                <doctest_block classes="doctest" xml:space="preserve">&gt;&gt;&gt; from hydra_zen import load_from_yaml, save_as_yaml</doctest_block>
                <doctest_block classes="doctest" xml:space="preserve">&gt;&gt;&gt; class B: pass
&gt;&gt;&gt; Conf = builds(B)</doctest_block>
                <doctest_block classes="doctest" xml:space="preserve">&gt;&gt;&gt; save_as_yaml(Conf, "config.yaml")
&gt;&gt;&gt; loaded_conf = load_from_yaml("config.yaml")</doctest_block>
                <paragraph>Note that the target of <literal>loaded_conf</literal> can be accessed without
                    instantiating the config.</paragraph>
                <doctest_block classes="doctest" xml:space="preserve">&gt;&gt;&gt; get_target(loaded_conf)  # type: ignore
